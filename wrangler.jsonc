// Cloudflare Workers (static assets) configuration for creatorsignals.blog.
// Deployed automatically by Workers Builds on every push to `main`.
// Security headers, CSP and caching live in public/_headers.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "creator-signals",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": true }
}
