// Cloudflare Workers (static assets) configuration for creatorsignals.blog.
// Deployed automatically by Workers Builds on every push to `main`.
// Security headers, CSP and caching live in public/_headers.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "creator-signals",
  "compatibility_date": "2026-11-01",
  // Worker: cookieless measurement, Payhip webhook and the Access-protected admin area (src/worker.js).
  "main": "src/worker.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // The Worker runs first only for these paths; all other requests are served straight from ./public.
    "run_worker_first": ["/admin", "/admin/*", "/api/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Custom domains are managed here so the config stays the source of truth.
  // (www → apex redirect and "Always Use HTTPS" are zone settings in the dashboard.)
  "routes": [
    { "pattern": "creatorsignals.blog", "custom_domain": true },
    { "pattern": "www.creatorsignals.blog", "custom_domain": true }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": { "enabled": true },
  // Admin data (no e-mail or IP addresses are stored). Schema: migrations/.
  // Live "Now online" counter: one Durable Object that keeps open pages in memory only (no storage used).
  "durable_objects": { "bindings": [{ "name": "PRESENCE", "class_name": "Presence" }] },
  "migrations": [{ "tag": "v1-presence", "new_sqlite_classes": ["Presence"] }],
  "d1_databases": [
    { "binding": "DB", "database_name": "creator-signals-admin", "database_id": "f17d2d9c-dd11-47f9-a74f-c3303d635bf9", "migrations_dir": "migrations" }
  ],
  // Cloudflare Access (Zero Trust) application that protects /admin and /api/admin.
  // Fill in after creating the Access application; until then the admin area stays closed (fail closed).
  // Secret (not here): PAYHIP_API_KEY  →  npx wrangler secret put PAYHIP_API_KEY
  // Cloudflare Access app "Creator Signals Admin" (covers /admin and /api/admin).
  // Neither value is secret: the AUD tag is in every Access token. The optional ADMIN_EMAILS
  // allow-list is NOT kept here (public repo): set it as a Worker *secret* in the dashboard.
  "vars": {
    "ACCESS_TEAM": "yellow-hall-123e.cloudflareaccess.com",
    "ACCESS_AUD": "efb92dc84183cf118a18fc2c5cb4c46cdedc875c01f895baa8a831d4d3255617"
  }
}
