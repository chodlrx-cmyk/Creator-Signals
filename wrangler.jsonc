// Cloudflare Workers (static assets) configuration for creatorsignals.blog.
// Deployed automatically by Workers Builds on every push to `main`.
// Security headers, CSP and caching live in public/_headers.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "creator-signals",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Custom domains are managed here so the config stays the source of truth.
  // (www → apex redirect and "Always Use HTTPS" are zone settings in the dashboard.)
  "routes": [
    { "pattern": "creatorsignals.blog", "custom_domain": true },
    { "pattern": "www.creatorsignals.blog", "custom_domain": true }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": { "enabled": true }
}
